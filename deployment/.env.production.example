# Copy to deployment/.env.production and replace every required value.
DOCKER_GID=
CLUSTBUSTER_ADMIN_USER=admin
CLUSTBUSTER_ADMIN_PASSWORD=
CLUSTBUSTER_USER=scientist
CLUSTBUSTER_USER_PASSWORD=
CLUSTBUSTER_IMAGE=clustbuster:production
CLUSTBUSTER_HTTP_PORT=80
CLUSTBUSTER_HTTPS_PORT=443
CLUSTBUSTER_IDLE_TIMEOUT_MS=900000
CLUSTBUSTER_MAX_LIFETIME_MINUTES=480
CLUSTBUSTER_MAX_SESSIONS=4
CLUSTBUSTER_SESSION_CPUS=4
CLUSTBUSTER_SESSION_MEMORY=16G
CLUSTBUSTER_MAX_UPLOAD_MB=2048
